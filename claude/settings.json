{
  "permissions": {
    "allow": [
      "Bash(gcloud run services describe *)",
      "Bash(gcloud run services list *)",
      "Bash(gcloud artifacts repositories list *)",
      "Bash(docker --version)",
      "Bash(firebase --version)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude.json)"
    ],
    "ask": [
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "model": "sonnet",
  "enabledPlugins": {
    "canary@canary": true,
    "code-review@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "canary": {
      "source": {
        "source": "github",
        "repo": "osauer/canary"
      }
    }
  },
  "language": "Japanese",
  "sandbox": {
    "mode": "ask"
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoCompactEnabled": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "SessionStart":[
      {
        "matcher": "*",
        "hooks":[
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
